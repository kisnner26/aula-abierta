APP_NAME="Aula Abierta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
TELESCOPE_ENABLED=false
APP_URL=http://127.0.0.1:8000
APP_FRONTEND_URL=http://127.0.0.1:5173
APP_TIMEZONE=UTC
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aula_abierta
DB_USERNAME=postgres
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173

# API token lifetimes
SANCTUM_TOKEN_EXPIRATION=15
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Cloudflare R2 (S3-compatible)
# PRODUCTION: set FILESYSTEM_DISK=r2 and provide the R2 credentials.
FILESYSTEM_DISK=local
PROTECTED_FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=aula-abierta
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# Google Calendar API creates the external Google Meet room.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=UTC
GOOGLE_MEET_DURATION_MINUTES=60
GOOGLE_SERVICE_ACCOUNT_JSON=

# Signed URL expiration (seconds)
R2_SIGNED_URL_EXPIRY=300
CONTENT_FINGERPRINT_KEY=
CONTENT_FINGERPRINT_TTL=300
CONTENT_FINGERPRINT_PIXEL_AMPLITUDE=2

# Watermark text appended to protected material
WATERMARK_TEXT="Aula Abierta - Confidential"

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
