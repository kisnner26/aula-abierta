FRONTEND_PORT=5173
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DB_DATABASE=aula_abierta
DB_USERNAME=aula
DB_PASSWORD=aula-development
MINIO_ROOT_USER=aula-minio
MINIO_ROOT_PASSWORD=aula-minio-development
AWS_BUCKET=aula-abierta
APP_KEY=
AULA_SEED_SUPER_ADMIN_PASSWORD=AulaDocker!2026
AULA_SEED_COORDINATOR_PASSWORD=AulaDocker!2026
AULA_SEED_TRAINER_PASSWORD=AulaDocker!2026
AULA_SEED_STUDENT_PASSWORD=AulaDocker!2026
# Enable polling for bind-mounted source files on Docker Desktop.
CHOKIDAR_USEPOLLING=true
